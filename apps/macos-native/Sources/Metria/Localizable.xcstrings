    },
    "Any phone using the current QR code or phrase will stop receiving updates." : {
      "localizations" : {
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Qualquer celular usando o QR code ou a frase atual deixará de receber atualizações." } }
      }
    },
    "Applies to the usage card; the provider rail always stays fully opaque so it reads as part of the display." : {
      "localizations" : {
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Aplica-se ao cartão de uso; a barra de provedores permanece sempre totalmente opaca para parecer parte da tela." } }
